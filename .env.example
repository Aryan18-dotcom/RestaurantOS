PORT=3000
HOST=0.0.0.0
# Optional public HTTPS origin used in customer QR codes (for example https://orders.example.com).
# This must route back to this server through a tunnel, reverse proxy, or router port forwarding.
PUBLIC_URL=
# Set to 1 only when running behind a trusted reverse proxy that sets X-Forwarded-Proto.
TRUST_PROXY=0
RESTAURANT_NAME=Maison Table
CURRENCY=INR
TAX_RATE=5
# Local trial only: change before exposing this app to the internet.
# Optional Google review URL. Use the restaurant's direct Google review link.
GOOGLE_REVIEW_URL=
# Optional Meta WhatsApp Cloud API credentials. Without these, e-bill opens a prefilled WhatsApp chat;
# broadcast sending stays disabled until the API is configured.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# Optional approved WhatsApp template name for business-initiated messages outside the 24-hour customer-service window.
WHATSAPP_EBILL_TEMPLATE=
WHATSAPP_BROADCAST_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en

# Payment Qr MetaData
UPI_ID=example@oksbi
PAYEE_NAME=bugness's Kaffee
CURRENCY=INR